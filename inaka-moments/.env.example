# ═══════════════════════════════════════════════════════════════════════════
# Inaka Moments — variables de entorno
# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (proyecto: inaka-moments, ref kdjsbvvmcilbcycgxygo) ────────────
# Dashboard → Settings → API
SUPABASE_URL=https://kdjsbvvmcilbcycgxygo.supabase.co
SUPABASE_KEY=                 # anon / publishable key (pública, va al cliente)
SUPABASE_SERVICE_KEY=         # service_role — SOLO servidor. NUNCA con prefijo NUXT_PUBLIC_

# ── Sitio ────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://inakamoments.com

# ── Anti-spam: Cloudflare Turnstile ─────────────────────────────────────────
# Desarrollo: claves de TEST de Cloudflare (siempre pasan).
# Producción: crea el widget en https://dash.cloudflare.com → Turnstile.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Email transaccional (Resend) — aviso de leads a la dueña ────────────────
# https://resend.com → API key. Sin clave, el aviso server-side se omite y el
# LeadWizard usa EmailJS como fallback de notificación (el lead SIEMPRE se
# guarda en la BD igualmente).
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=Inaka Moments <onboarding@resend.dev>   # en prod: dominio verificado
NUXT_EMAIL_BUSINESS=nadine.tcae@gmail.com                # destinataria de los avisos

# ── EmailJS — Lead form (fallback de notificación, legado) ───────────────────
# Get these from https://www.emailjs.com/docs/
NUXT_PUBLIC_EMAILJS_SERVICE_ID=    # Service ID (e.g. service_xxxxxxxx)
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=   # Template ID (e.g. template_xxxxxxxx)
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=    # Public Key (e.g. xxxxxxxxxxxxxxx)
NUXT_PUBLIC_EMAILJS_RECIPIENT=nadine.tcae@gmail.com
