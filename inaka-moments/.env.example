# ═══════════════════════════════════════════════════════════════════════════
# Inaka Moments — variables de entorno
# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (proyecto: inaka-moments, ref kdjsbvvmcilbcycgxygo) ────────────
# Dashboard → Settings → API
SUPABASE_URL=https://kdjsbvvmcilbcycgxygo.supabase.co
SUPABASE_KEY=                 # anon / publishable key (pública, va al cliente)
SUPABASE_SERVICE_KEY=         # service_role — SOLO servidor. NUNCA con prefijo NUXT_PUBLIC_

# ── Sitio ────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://inakamoments.com

# ── EmailJS — Lead form (legado, fallback) ──────────────────────────────────
# Get these from https://www.emailjs.com/docs/
NUXT_PUBLIC_EMAILJS_SERVICE_ID=    # Service ID (e.g. service_xxxxxxxx)
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=   # Template ID (e.g. template_xxxxxxxx)
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=    # Public Key (e.g. xxxxxxxxxxxxxxx)
NUXT_PUBLIC_EMAILJS_RECIPIENT=nadine.tcae@gmail.com
