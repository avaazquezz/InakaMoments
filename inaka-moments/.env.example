# ─── Email notifications via Resend ───────────────────────────────────────────
# Crea una cuenta gratuita en https://resend.com
# Free tier: 3 000 emails/mes
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# El remitente del email (debe ser un dominio verificado en Resend)
# Para pruebas puedes usar: onboarding@resend.dev
RESEND_FROM_EMAIL=Inaka Moments <no-reply@inakamoments.com>

# Email donde quieres recibir las notificaciones (el de tu prima)
NOTIFICATION_EMAIL=inakamoments@gmail.com


# ─── Airtable (spreadsheet online) ────────────────────────────────────────────
# 1. Crea una cuenta gratis en https://airtable.com
# 2. Crea una Base nueva llamada "Inaka Moments - Leads"
# 3. Crea una tabla con estas columnas:
#    Nombre | Email | WhatsApp | Tipo de evento | Fecha aproximada |
#    Invitados | Espacios | Estilo | Ideas especiales | Fecha de solicitud
# 4. Ve a https://airtable.com/create/tokens y crea un token con permiso:
#    data.records:write  → sobre tu base
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de tu Base (aparece en la URL: airtable.com/ESTE_VALOR/...)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Nombre de la tabla (por defecto Airtable la llama "Table 1", cámbialo a "Leads")
AIRTABLE_TABLE_ID=Leads
